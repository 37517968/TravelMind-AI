    {"type":"timeseries","title":"Agent Node P95","datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"s"}},"targets":[{"expr":"histogram_quantile(0.95, sum by (le, node) (rate(agent_node_duration_seconds_bucket[10m])))","legendFormat":"{{node}}"}],"gridPos":{"h":7,"w":6,"x":12,"y":1},"id":4},
