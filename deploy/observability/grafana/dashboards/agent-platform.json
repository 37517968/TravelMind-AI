    {"type":"timeseries","title":"Outbox & RabbitMQ Backlog","datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"max(agent_outbox_backlog)","legendFormat":"outbox"},{"expr":"sum by (queue) (rabbitmq_queue_messages_ready)","legendFormat":"{{queue}}"}],"gridPos":{"h":7,"w":8,"x":16,"y":9},"id":8},

