    {"type":"timeseries","title":"Tool Outcome / Error Code","datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"sum by (tool, outcome, error_code) (rate(tool_calls_total[10m]))","legendFormat":"{{tool}} {{outcome}} {{error_code}}"}],"gridPos":{"h":7,"w":8,"x":8,"y":17},"id":11},
