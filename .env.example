# 复制为 .env 后填写真实值。不要提交 .env。
MYSQL_PASSWORD=请替换为强密码
DASHSCOPE_API_KEY=请填写阿里云百炼API Key
# Chat 模型 provider：类路径同时有 DashScope 与 Ollama 两个 ChatModel，必须显式选一个，否则启动报按类型注入歧义。
CHAT_MODEL=dashscope
RABBITMQ_USERNAME=agent
RABBITMQ_PASSWORD=请替换为强密码
PGVECTOR_USERNAME=travel
PGVECTOR_PASSWORD=请替换为强密码
ES_JAVA_OPTS=-Xms512m -Xmx512m
# 实时工具只在 agent-worker 里注册；关掉或 Key 为空会静默降级成纯文本行程。
MCP_REMOTE_ENABLED=true
# 填高德开放平台「Web 服务」平台的 Key，不是 JS API Key，也不需要安全密钥。
AMAP_MCP_API_KEY=
AMAP_MCP_REQUEST_TIMEOUT=10s
AMAP_MCP_REQUIRED=false
# 单个用户在地图工作流中的 MCP 调用配额；普通工具仍保持 5 QPS。
USER_MAP_TOOL_QPS=20
# 前端高德 JS API 使用独立的「Web 端(JS API)」Key + 安全密钥；不要复用或暴露后端 MCP Key。
VITE_AMAP_JS_API_KEY=
VITE_AMAP_JS_SECURITY_CODE=

# 以下能力不用时可留空
SEARCH_API_KEY=

# 仅当使用宿主机 Ollama 时需要调整
OLLAMA_BASE_URL=http://host.docker.internal:11434

# docker compose --profile observability up 时启用 Trace；普通开发可保持 0。
OTEL_TRACES_SAMPLER_PROBABILITY=0.0
GRAFANA_ADMIN_PASSWORD=请替换为强密码

# 管理/监控类端口的宿主机绑定地址：默认只监听回环，避免 RabbitMQ 管理台等直接暴露公网。
# 本机访问用 SSH 隧道：ssh -L 15672:127.0.0.1:15672 user@server；确需公网访问才改成 0.0.0.0 并自行加防火墙限制。
ADMIN_BIND_IP=127.0.0.1
